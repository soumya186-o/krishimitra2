# KrishiMitra Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./krishimitra.db

# Cloud AI Provider Configuration (Options: local, openai, gemini)
# Default is 'local' to ensure zero mandatory external credentials for offline/local runs
AI_FALLBACK_PROVIDER=local

# Cloud AI API Keys (Optional - only required if AI_FALLBACK_PROVIDER is changed to openai or gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Weather API (Default uses Open-Meteo open free agricultural API, no key required)
WEATHER_PROVIDER=open_meteo
